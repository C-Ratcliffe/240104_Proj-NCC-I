        <PAGEOBJECT XPOS="525.197480314961" YPOS="27.087874015748" OwnPage="0" ItemID="203036992" PTYPE="4" WIDTH="134.645669291339" HEIGHT="609.448818897638" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L134.646 0 L134.646 609.449 L0 609.449 L0 0 Z" copath="M0 0 L134.646 0 L134.646 609.449 L0 609.449 L0 0 Z" gXpos="525.197480314961" gYpos="27.087874015748" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESPMode="0" LINESP="11" FONT="Roboto Light" FONTSIZE="10"/>
                <ITEXT FONT="Roboto Light" FONTSIZE="10" CH="01: FreeSurfer recon-all including flairpial/t2Pial"/>
                <ITEXT CH=" is run on the structural images"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT FONTSIZE="10" CH="02: Application of ANTs N4BiasFieldCorrection,  HD-BET brain extraction, and FSL flirt registration to the brain-extracted MNI template, followed by FSL run_first_all"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="03: "/>
                <ITEXT FONT="Roboto Light" FONTSIZE="10" CH="Automatic &amp; manual reconstruction quality assessment is carried out,  and metrics are formatted with aparcstats2table"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="04: "/>
                <ITEXT FONTSIZE="10" CH=" FSL concat_bvars and first_utils"/>
                <ITEXT CH=" are used to construct grouped subcortical surface meshes"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="05: BrainSegVolNotVent is extracted for use in design matrices"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="06: In R, Morphometric features are extracted, standardised across participants, and vectorised. Pearson correlations between region vectors provide individual morphometric similarity matrices"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="07: FSL "/>
                <ITEXT FONTSIZE="10" CH="randomise is used for hypothesis testing. Custom shell scripts are used to extract critical values from output images"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="08: Network based statstics are computed using the NBR package in R, which identifies and inferencially examines putative subnetworks based on adjacency matrices"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="09: T1w/T2w ratio images are generated using a combination of ANTs and FSL tools"/>
                <trail LINESPMode="0" LINESP="11"/>
            </StoryText>
