        <PAGEOBJECT XPOS="532.284094488189" YPOS="27.087874015748" OwnPage="0" ItemID="194389264" PTYPE="4" WIDTH="134.645669291339" HEIGHT="609.448818897638" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L134.646 0 L134.646 609.449 L0 609.449 L0 0 Z" copath="M0 0 L134.646 0 L134.646 609.449 L0 609.449 L0 0 Z" gXpos="532.284094488189" gYpos="27.087874015748" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESPMode="0" LINESP="11" FONT="Roboto Light" FONTSIZE="10"/>
                <ITEXT FONT="Roboto Light" FONTSIZE="10" CH="01: FreeSurfer outputs and raw fMRI timeseries are preprocessed with fMRIprep, providing MNI-space slice-time and susceptibility distortion corrected fMRI timeseries, as fell as confound and regressor parameters"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT FONT="Roboto Light" FONTSIZE="10" CH="02: Warp matrices are applied to subject-space lesion masks with antsApplyTransforms, providing MNI-space lesion ROIs"/>
                <para LINESPMode="0" LINESP="11"/>
                <para/>
                <ITEXT CH="03: The susceptibility and slice-time corrected timeseries are denoised, low-and high-bandpass filtered, and confound-regressed in the CONN toolbox"/>
                <para/>
                <para/>
                <ITEXT CH="04: Seed-based connectivity is computed on a per-subject basis, by correlating the cyst/oedema timeseries with the timeseries of every other voxel in the brain mask"/>
                <para/>
                <para/>
                <ITEXT CH="05: ROI-to-ROI connectivity is computed on a per-subject basis through pairwised correlations of the timeseries from all 164 regions in a truncated Destrieux atlas (alongside the CONN default atlas, for validation)"/>
                <para/>
                <para/>
                <ITEXT CH="06: After Fisher transforming the correlation maps, signficant differences are tested for significance (the comparisons are defined by the design matrices), providing family-wise-error corrected signficance maps"/>
                <para/>
                <para/>
                <ITEXT CH="07: Functional connectivity is similarly evaluated for significance between the grouped ROI-to-ROI matrices"/>
                <trail/>
            </StoryText>
        </PAGEOBJECT>
