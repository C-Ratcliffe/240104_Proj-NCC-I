        <PAGEOBJECT XPOS="666.92976377953" YPOS="27.087874015748" OwnPage="0" ItemID="204108464" PTYPE="4" WIDTH="134.645669291339" HEIGHT="467.716535433071" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L134.646 0 L134.646 467.717 L0 467.717 L0 0 Z" copath="M0 0 L134.646 0 L134.646 467.717 L0 467.717 L0 0 Z" gXpos="666.92976377953" gYpos="27.087874015748" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle LINESPMode="0" LINESP="11" FONT="Roboto Light" FONTSIZE="10"/>
                <ITEXT FONT="Roboto Light" FONTSIZE="10" CH="01: "/>
                <ITEXT CH="Participant information is extracted from patient records"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT FONTSIZE="10" CH="02: "/>
                <ITEXT CH="Appropriate predictive factors were chosen based on literature evaluation"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="03: MRI data is extracted from the primarily archival DICOM format, and converted into BIDS compliant nifti files"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="04: "/>
                <ITEXT FONTSIZE="10" CH=" "/>
                <ITEXT CH="The relevant participant data is operationalised from the study datasheet"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="05: Using MRView, FSLmaths and FreeSurfer's recon-all command, oedema and whole brain volumes are estimated for the participants"/>
                <para LINESPMode="0" LINESP="11"/>
                <para LINESPMode="0" LINESP="11"/>
                <ITEXT CH="06: Inference testing is carried out in R statistics"/>
                <para LINESPMode="0" LINESP="11"/>
            </StoryText>
        </PAGEOBJECT>
    </DOCUMENT>
